# Existing DGD community services. Keep the values already configured in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=
# Optional for builds. Required at runtime for the corresponding SMS features.
# Verification uses VERIFY_SERVICE_SID; notification texts use MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

# Shopify Headless channel. All three values belong on the server only.
# Do not use a NEXT_PUBLIC_ prefix for Shopify credentials.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Optional exact hostname if Shopify uses a custom checkout domain.
# Example: checkout.your-domain.com (no https:// or path).
SHOPIFY_CHECKOUT_DOMAIN=
