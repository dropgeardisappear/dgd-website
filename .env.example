# Existing DGD community services. Keep the values already configured in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional for builds. Required at runtime to send email notifications.
RESEND_API_KEY=
# Optional for builds. Required at runtime for the corresponding SMS features.
# Verification uses VERIFY_SERVICE_SID; notification texts use MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

# Shop payments. Server only: never add NEXT_PUBLIC_ to these names.
# Set either the Supabase secret key or the legacy service-role key, not both.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Stripe payment-method configuration ID (pmc_...) for this shop.
STRIPE_PAYMENT_METHOD_CONFIGURATION=
# Optional canonical origin. Otherwise uses the current Vercel deployment URL.
SHOP_SITE_URL=
# Optional owner order alerts: verified Resend sender, e.g. DGD <orders@your-domain>.
SHOP_FROM_EMAIL=
